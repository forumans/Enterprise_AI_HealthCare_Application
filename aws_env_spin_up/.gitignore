# Contains real production secrets (DATABASE_URL, JWT_SECRET) pulled from the live Lambda.
.env.production.backup.json

# Contains real AWS account/infra identifiers (account ID, RDS endpoint, subnet/security-group
# IDs, S3 bucket names, CloudFront domain) - not credentials, but not for a public repo either.
# See aws-config.example.json for the shape.
scripts/aws-config.local.json

# Auto-generated by teardown.ps1 on every run; carries the same class of real infra identifiers
# (VPC-derived subnet group name, security group ID) as aws-config.local.json above.
scripts/last-teardown-metadata.json
